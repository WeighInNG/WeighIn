{
  "name": "weighin",
  "version": "1.0.0",
  "description": "Resource-Cost Benchmarking & CI Regression Toolkit for Soroban",
  "main": "dist/index.js",
  "bin": {
    "weighin": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "tsc --noEmit && esbuild src/action.ts --bundle --platform=node --target=node20 --outfile=bundled/index.js --format=cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "build:helper": "cargo +1.95.0 build --release --locked --manifest-path native/simulation/Cargo.toml --target-dir native/simulation/target --target x86_64-unknown-linux-gnu",
    "test:native": "npm run build && npm run build:helper && node --test tests/native/*.test.cjs"
  },
  "dependencies": {
    "@actions/core": "2.0.0",
    "@actions/exec": "1.1.1",
    "@actions/github": "9.1.1",
    "@stellar/stellar-sdk": "16.0.1",
    "toml": "3.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.25.6",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "bundled",
    "native/simulation/Cargo.toml",
    "native/simulation/Cargo.lock",
    "native/simulation/src",
    "action.yml",
    "docs/native-measurement.md",
    "docs/contract-build.md",
    "docs/metric-provenance.md",
    "docs/snapshot-recovery.md",
    "docs/fixture-migration.md"
  ]
}
