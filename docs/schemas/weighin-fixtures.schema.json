{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contracts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "wasm_path": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "invocations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "function_name": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "symbol",
                              "string",
                              "u32",
                              "i32",
                              "bool",
                              "u64",
                              "i64",
                              "u128",
                              "i128",
                              "address",
                              "bytes",
                              "vec",
                              "map"
                            ]
                          },
                          "value": {}
                        },
                        "required": [
                          "type",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "symbol",
                              "string",
                              "u32",
                              "i32",
                              "bool",
                              "u64",
                              "i64",
                              "u128",
                              "i128",
                              "address",
                              "bytes",
                              "vec",
                              "map"
                            ]
                          },
                          "binding": {
                            "type": "object",
                            "properties": {
                              "contract": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "select": {
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "object",
                                      "properties": {
                                        "field": {
                                          "type": "string",
                                          "minLength": 1
                                        }
                                      },
                                      "required": [
                                        "field"
                                      ],
                                      "additionalProperties": false
                                    },
                                    {
                                      "type": "object",
                                      "properties": {
                                        "index": {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 9007199254740991
                                        }
                                      },
                                      "required": [
                                        "index"
                                      ],
                                      "additionalProperties": false
                                    }
                                  ]
                                }
                              }
                            },
                            "required": [
                              "contract"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "type",
                          "binding"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "function_name",
                "args"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "wasm_path",
          "invocations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contracts"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/WeighInNG/WeighIn/main/docs/schemas/weighin-fixtures.schema.json",
  "title": "WeighIn fixture declarations",
  "description": "Input contract for weighin-fixtures.json. Invocation values are checked by the matching runtime argument validator.",
  "x-weighin-identities": {
    "fixture": "Explicit top-level id becomes fixture_id; otherwise the normalized relative fixture path becomes path:<path>.",
    "contract": "Explicit contract id becomes logical_id; otherwise normalized wasm_path becomes wasm:<path>.",
    "invocation": "Explicit invocation id becomes case_id; otherwise canonicalized typed arguments become args:<json>."
  }
}
